# ============================================================
# AI Math Institute - 环境变量模板
# 使用方法: 复制本文件为 .env，并填入你的真实 API Key
#   cp .env.example .env
# 注意: .env 已被 .gitignore 排除，切勿提交到版本库
# ============================================================

# DeepSeek API 密钥 (必填) - 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=

# DeepSeek API 基础地址 (OpenAI 兼容端点)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 推理模型 (Prover Agent 用 - 负责生成 Lean 4 证明)
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# 对话模型 (Critic Agent 用 - 负责审阅/打分/提出反例)
DEEPSEEK_CHAT_MODEL=deepseek-chat
